# クラウド同期（Supabase）の接続情報の見本。
# このファイルを .env.local という名前でコピーして値を入れてください（.env.local は Git の管理対象外）。
# 値が空なら、ログインと同期の機能は表示されず、端末内だけで動きます。
#
# ここに書くのは公開して問題のない値だけです。
# 管理用の secret key（sb_secret_ で始まるもの）は絶対に書かないでください。

# Supabase の管理画面 → Project Settings → API（または Connect）で確認できます
EXPO_PUBLIC_SUPABASE_URL=
# 「Publishable key」（sb_publishable_ で始まるもの）
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
